{% if applicationData['limits']['workers'] is not empty %}
PHP_FPM_PM=static
PHP_FPM_PM_MAX_CHILDREN={{ applicationData['limits']['workers'] }}
{% endif %}
{% if applicationData['limits']['request-terminate-timeout'] is not empty %}
PHP_FPM_REQUEST_TERMINATE_TIMEOUT={{ applicationData['limits']['request-terminate-timeout'] }}
{% endif %}

